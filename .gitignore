# R package build artefacts (now under R/)
R/src/*.o
R/src/*.so
R/src/*.dll
R/src/RcppExports.cpp
R/R/RcppExports.R

# Headers in R/inst/include/ are generated by the configure script (or
# scripts/sync-headers.sh before R CMD build).  Canonical: include/libqe/
R/inst/include/libqe/*.hpp

# General R artefacts
*.Rcheck/
*.tar.gz
.Rproj.user/

# Python
**/__pycache__/
python/build/
