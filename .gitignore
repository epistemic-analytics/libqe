# R package build artefacts (now under R/)
R/src/*.o
R/src/*.so
R/src/*.dll
# RcppExports.cpp and RcppExports.R are committed — they must be present for
# R CMD INSTALL to work without requiring Rcpp tooling on the consumer side.

# Headers in R/inst/include/ are generated by the configure script (or
# scripts/sync-headers.sh before R CMD build).  Canonical: include/<lib>/
R/inst/include/libqe/*.hpp
R/inst/include/libena/*.hpp
R/inst/include/libtma/*.hpp

# General R artefacts
*.Rcheck/
*.tar.gz
.Rproj.user/

# Python
**/__pycache__/
python/build/
# Copied from include/ by scripts/sync-headers.sh so the sdist is self-contained.
python/include/

# WASM
wasm/dist/
wasm/build/
wasm/node_modules/
wasm/.conan2/
wasm/CMakeUserPresets.json

# Julia — compiled shared library (built and placed here by cranqe)
julia/lib/
julia/build/
julia/Manifest.toml

# OS / Editor files
.DS_Store
**/.DS_Store

