# Conan v2 cross-compilation profile for WebAssembly via Emscripten.
#
# Prerequisites (one-time):
#   brew install emscripten        # macOS
#   apt-get install emscripten     # Debian/Ubuntu
#
# Usage (from repo root):
#   conan install . -pr:b=default -pr:h=profiles/wasm --build=missing
#   emcmake cmake -B build/wasm -DCMAKE_BUILD_TYPE=Release \
#       -DCMAKE_TOOLCHAIN_FILE=build/wasm/conan_toolchain.cmake .
#   emmake make -C build/wasm

[settings]
os          = Emscripten
arch        = wasm
compiler    = clang
compiler.version = 18
compiler.libcxx  = libc++
build_type  = Release

[options]
# Armadillo: disable all optional compiled dependencies — none can be
# cross-compiled to WASM and Armadillo's Conan recipe rejects the attempt.
armadillo*:use_blas   = False
armadillo*:use_lapack = False
armadillo*:use_hdf5   = False

[conf]
tools.cmake.cmaketoolchain:generator = Ninja
